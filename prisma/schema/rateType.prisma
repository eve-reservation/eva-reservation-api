enum RateUnit {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  PER_SESSION
  PER_PERSON
  FLAT_RATE
}

model RateType {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  
  // Organization identifier
  organizationId  String
  
  baseRate        Float
  currency        String          @default("PHP")
  
  // Rate unit (hourly, daily, weekly, monthly, per-session, per-person, flat-rate)
  rateUnit        RateUnit?
  serviceFee      Float?
  tax             Float?
  
  // Seasonal or time-based adjustments
  adjustments     Json?
  
  facilities      Facility[]
  
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}