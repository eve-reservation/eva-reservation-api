enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

type reservationPeriod {
  startDateTime  DateTime
  endDateTime    DateTime
  numberOfDays   Int
  numberOfHours  Float?
  originalHours  Float?  
  extendedHours  Float? 
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
}

type PricingBase {
  planBasePrice Float 
  daysBooked    Int
  planTotal     Float 
}

type Charges {
  serviceFee   Float @default(0)
  extensionFee Float @default(0)
  addonFee     Float @default(0)
}


type Taxes {
  tax           Float
  taxPercentage Float @default(12) 
}

type Discounts {
  couponCode         String?
  discount           Float   @default(0)
  discountPercentage Float?
}

type Totals {
  subtotal    Float
  totalAmount Float
}

model Reservation {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  
  // Organization identifier
  organizationId  String?
  
  userId          String?
  
  facility        Facility          @relation(fields: [facilityId], references: [id])
  facilityId      String            @db.ObjectId
  
  status          ReservationStatus @default(PENDING)

  // Industry standard: Store guest count in reservation for quick access
  // Guests are stored in separate Guest table with minimal data
  // Full guest details available via Person relation (optional)
  guestCount      Int               @default(1)
  
  // Relation to Guest model (one-to-many)
  // Load guests conditionally via fields parameter to minimize data transfer
  guests          Guest[]
  
  purpose         String?          
  eventName       String?
  
  specialRequests String?
  internalNotes   String?
  
  bookingSource   String?
  confirmationCode String           @unique @default(cuid())
  
  checkedInBy     String?
  checkedOutBy    String?
  
  addOns          Json?
  
  bookingPeriod   reservationPeriod?
  pricingBase     PricingBase?
  charges         Charges?
  taxes           Taxes?
  discounts       Discounts?
  totals          Totals?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Matchmaking relation (optional - one reservation can have one match event)
  matchEvent      MatchEvent?

}