enum SpaceType {
  ROOM              // Indoor enclosed spaces (hotel rooms, conference rooms, offices)
  COURT             // Sports/recreation courts (tennis, basketball, etc.)
  DINING            // Food & beverage spaces (restaurant, cafe, bar)
  FITNESS           // Gym and fitness facilities
  PARKING           // Parking spaces/lots
  AMENITY           // Pool, spa, lounge, etc.
  OUTDOOR           // Outdoor spaces (garden, terrace, etc.)
  OTHER
}

enum RoomSubtype {
  GUEST_ROOM        // Hotel/accommodation rooms
  CONFERENCE_ROOM   // Meeting/conference rooms
  OFFICE            // Office spaces
  STUDIO            // Photography/recording studio
  CLASSROOM         // Training/education rooms
  BALLROOM          // Event/banquet halls
  SUITE             // Multi-room suites
  OTHER
}

enum CourtSubtype {
  TENNIS
  BASKETBALL
  VOLLEYBALL
  BADMINTON
  SQUASH
  RACQUETBALL
  PICKLEBALL
  MULTIPURPOSE
  OTHER
}

enum DiningSubtype {
  FINE_DINING
  CASUAL_DINING
  CAFE
  BAR
  LOUNGE
  BUFFET
  PRIVATE_DINING
  FOOD_COURT
  OTHER
}

enum FitnessSubtype {
  WEIGHT_ROOM
  CARDIO_AREA
  YOGA_STUDIO
  SPIN_STUDIO
  CROSSFIT_BOX
  PILATES_STUDIO
  MULTIPURPOSE
  OTHER
}

enum ParkingSubtype {
  COVERED
  OPEN_LOT
  GARAGE
  VALET
  EV_CHARGING
  DISABLED
  MOTORCYCLE
  BICYCLE
  OTHER
}

enum AmenitySubtype {
  SWIMMING_POOL
  HOT_TUB
  SAUNA
  STEAM_ROOM
  SPA
  LIBRARY
  BUSINESS_CENTER
  GAME_ROOM
  LOUNGE
  ROOFTOP
  GARDEN
  OTHER
}

enum FacilityStatus {
  AVAILABLE         // Ready to be reserved/used
  OCCUPIED          // Currently in use
  RESERVED          // Reserved but not yet occupied
  MAINTENANCE       // Under maintenance/repair
  CLEANING          // Being cleaned/prepared
  OUT_OF_SERVICE    // Temporarily unavailable
  BLOCKED           // Manually blocked (not available for booking)
}

enum FacilityImageType {
  COVER             // Main cover/hero image
  FEATURED          // Featured images
  GALLERY           // Gallery images
  THUMBNAIL         // Thumbnail/preview image
  FLOOR_PLAN        // Floor plan/layout image
  EXTERIOR          // Exterior view
  INTERIOR          // Interior view
  AMENITY           // Amenity-specific image
  OTHER
}

type FacilityImage {
  name String?
  url  String?
  type FacilityImageType?
}

model Facility {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  
  // Reference to facility type template
  facilityType    FacilityType    @relation(fields: [facilityTypeId], references: [id], onDelete: Cascade)
  facilityTypeId  String          @db.ObjectId
  
  // Unique identifier within organization
  // Examples: "Room 101", "Suite 205", "Conference Room A", "Tennis Court 1", "Parking B12"
  identifier      String
  displayName     String?         // Optional friendly name
  
  // Organization relationship
  organizationId  String?

  
  // Location details (contains all hierarchical information: building, floor, wing, zone, etc.)
  location        Location?       @relation(fields: [locationId], references: [id])
  locationId      String?         @db.ObjectId
  
  // Pricing
  rateTypeId      String?         @db.ObjectId
  rateType        RateType?       @relation(fields: [rateTypeId], references: [id])
  
  // Hierarchical classification
  spaceType      SpaceType?
  subtype        String?  // Stores the appropriate subtype enum value as string

  // Instance-specific attributes (overrides facilityType)
  attributes      Json?

  // Hierarchical classification
 

  // Polymorphic metadata based on spaceType + subtype
  // Examples:
  // - ROOM + GUEST_ROOM: {bedType, bedCount, maxOccupancy, roomFeatures, amenities}
  // - ROOM + CONFERENCE_ROOM: {seatingCapacity, layout, hasProjector, hasVideoConferencing}
  // - COURT + TENNIS: {surfaceType, isIndoor, hasLights, maxPlayers}
  // - DINING + FINE_DINING: {cuisineType, seatingCapacity, dresscode, avgMealPrice}
  metadata        Json?

  // Images specific to this facility instance
  images          FacilityImage[]
  
  // Status (replaces isActive and isUnderMaintenance)
  status          FacilityStatus  @default(AVAILABLE)
  
  // Relationships
  reservations    Reservation[]
  // availability    AvailabilityRule[]
  // maintenanceLog  MaintenanceLog[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@unique([organizationId, identifier])
  @@index([facilityTypeId])
  @@index([locationId])
  @@index([rateTypeId])
  @@index([status])
  @@index([spaceType])
  @@index([subtype])
}