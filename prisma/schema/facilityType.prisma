
model FacilityType {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  code           String?
  // Classification
  spaceType      SpaceType? // Matches enum from facility.prisma
  subtype        String?    // Stores specific subtype enum value as string

  // Organization identifier only (organization lives in another service)
  organizationId String?

  // Relationships
  facilities     Facility[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([name])
}