enum SpaceType {
  ROOM              // Indoor enclosed spaces (hotel rooms, conference rooms, offices)
  COURT             // Sports/recreation courts (tennis, basketball, etc.)
  DINING            // Food & beverage spaces (restaurant, cafe, bar)
  FITNESS           // Gym and fitness facilities
  PARKING           // Parking spaces/lots
  AMENITY           // Pool, spa, lounge, etc.
  OUTDOOR           // Outdoor spaces (garden, terrace, etc.)
  OTHER
}

enum RoomSubtype {
  GUEST_ROOM        // Hotel/accommodation rooms
  CONFERENCE_ROOM   // Meeting/conference rooms
  OFFICE            // Office spaces
  STUDIO            // Photography/recording studio
  CLASSROOM         // Training/education rooms
  BALLROOM          // Event/banquet halls
  SUITE             // Multi-room suites
  OTHER
}
enum CourtSubtype {
  TENNIS
  BASKETBALL
  VOLLEYBALL
  BADMINTON
  SQUASH
  RACQUETBALL
  PICKLEBALL
  MULTIPURPOSE
  OTHER
}

enum DiningSubtype {
  FINE_DINING
  CASUAL_DINING
  CAFE
  BAR
  LOUNGE
  BUFFET
  PRIVATE_DINING
  FOOD_COURT
  OTHER
}

enum FitnessSubtype {
  WEIGHT_ROOM
  CARDIO_AREA
  YOGA_STUDIO
  SPIN_STUDIO
  CROSSFIT_BOX
  PILATES_STUDIO
  MULTIPURPOSE
  OTHER
}

enum ParkingSubtype {
  COVERED
  OPEN_LOT
  GARAGE
  VALET
  EV_CHARGING
  DISABLED
  MOTORCYCLE
  BICYCLE
  OTHER
}

enum AmenitySubtype {
  SWIMMING_POOL
  HOT_TUB
  SAUNA
  STEAM_ROOM
  SPA
  LIBRARY
  BUSINESS_CENTER
  GAME_ROOM
  LOUNGE
  ROOFTOP
  GARDEN
  OTHER
}

model FacilityType {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String?
  description    String?

  // Hierarchical classification
  spaceType      SpaceType
  subtype        String?  // Stores the appropriate subtype enum value as string

  // Organization identifier only (organization lives in another service)
  organizationId String

  // Polymorphic metadata based on spaceType + subtype
  // Examples:
  // - ROOM + GUEST_ROOM: {bedType, bedCount, maxOccupancy, roomFeatures}
  // - ROOM + CONFERENCE_ROOM: {seatingCapacity, layout, hasProjector, hasVideoConferencing}
  // - COURT + TENNIS: {surfaceType, isIndoor, hasLights, maxPlayers}
  // - DINING + FINE_DINING: {cuisineType, seatingCapacity, dresscode, avgMealPrice}
  metadata       Json?

  // Pricing
  rateTypeId     String?  @db.ObjectId
  rateType       RateType? @relation(fields: [rateTypeId], references: [id])

  // Images
  imageUrl       String[]  @default([])

  // Path for hierarchical organization
  path           String?

  // Relationships
  facilities     Facility[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([spaceType])
  @@index([subtype])
  @@index([name])
}